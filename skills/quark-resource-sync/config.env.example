# 复制为 config.env 后填入真实值（config.env 不入库）
# TMDB Read Access Token（https://www.themoviedb.org/settings/api）
TMDB_TOKEN=
# 本机代理（TMDB 用；脚本在代理不可用时会自动回退直连）
PROXY=http://127.0.0.1:10808
# ShareResource 站点仓库路径
REPO=~/Documents/GitHub/ShareResource
# 夸克网盘 SHARE 目录的 fid
SHARE_FID=
# 夸克 CLI 路径
QUARK_CLI=~/.workbuddy/skills/quarkclouddrive/scripts/quark-drive.cjs
