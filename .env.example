# 本地开发（SQLite，零依赖）
DATABASE_URL="file:./dev.db"

# 生产环境切换到 PostgreSQL：
# DATABASE_URL="postgresql://user:password@localhost:5432/planetresource?schema=public"
# 同时把 prisma/schema.prisma 的 provider 改为 "postgresql"

# 后台访问口令（Phase 4 临时方案，后续由 Auth.js + RBAC 接管 §9.2）
ADMIN_PASSWORD="planetresource"
# 会话 Cookie 签名密钥，生产环境请替换为随机长字符串
ADMIN_SESSION_SECRET="please-change-this-to-a-random-string"
