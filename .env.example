# 本地开发（SQLite，零依赖）
DATABASE_URL="file:./dev.db"

# ===== Docker Compose 生产部署 =====
# 复制本文件为 .env 后，docker-compose.yml 会读取以下变量：
#   POSTGRES_PASSWORD  必填，数据库密码（compose 会拼出 DATABASE_URL）
#   ADMIN_SESSION_SECRET 必填，会话签名密钥，用 `openssl rand -hex 32` 生成
#   ADMIN_PASSWORD     选填，后台口令（Phase 4 临时方案，后续 Auth.js + RBAC 接管 §9.2）
# Postgres schema 见 prisma/schema.postgres.prisma（容器内自动切换，本地仍用 sqlite）
POSTGRES_PASSWORD="change-me"

# 后台访问口令（Phase 4 临时方案，后续由 Auth.js + RBAC 接管 §9.2）
ADMIN_PASSWORD="planetresource"
# 会话 Cookie 签名密钥，生产环境请替换为随机长字符串
ADMIN_SESSION_SECRET="please-change-this-to-a-random-string"
